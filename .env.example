# PrivaseeAI Security - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =====================================
# Telegram Alerting (Optional)
# =====================================
# 1. Create bot with @BotFather on Telegram
# 2. Get your bot token
# 3. Message your bot, then get chat ID from:
#    https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# =====================================
# Monitoring Settings
# =====================================
# Path to iOS backups (auto-detected if not set)
BACKUP_DIRECTORY=~/Library/Application Support/MobileSync/Backup
# For iMazing backups:
# BACKUP_DIRECTORY=~/Library/Application Support/iMazing/Backups

# Monitoring intervals (seconds)
MONITOR_INTERVAL=60
WATCH_INTERVAL=5

# =====================================
# VPN Monitoring (Optional - for live log monitoring)
# =====================================
# Directory containing VPN logs to monitor
# VPN_LOG_DIR=~/ios_device_logs

# =====================================
# Application Settings
# =====================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
MAX_FILE_SIZE=104857600  # 100 MB

# =====================================
# Encryption
# =====================================
ENCRYPTION_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM

# =====================================
# Development Settings
# =====================================
# Set to 'false' in production
DEBUG=false
RELOAD=false
