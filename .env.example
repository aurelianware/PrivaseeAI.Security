# PrivaseeAI Security - Environment Configuration Example
# Copy this file to .env and update with your actual values

# =====================================
# Database Configuration (TimescaleDB)
# =====================================
DATABASE_HOST=timescaledb
DATABASE_PORT=5432
DATABASE_NAME=privaseeai_security
DATABASE_USER=privaseeai
DATABASE_PASSWORD=changeme

# =====================================
# Redis Configuration
# =====================================
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty for no password, or set a strong password
REDIS_PASSWORD=

# =====================================
# Application Configuration
# =====================================
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000

# =====================================
# pgAdmin Configuration (Optional)
# =====================================
# Only needed if using pgAdmin (docker-compose --profile admin up)
PGADMIN_EMAIL=admin@privaseeai.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =====================================
# Security Settings
# =====================================
# Set to 'true' in production
ENCRYPTION_ENABLED=true
ENCRYPTION_ALGORITHM=AES-256-GCM

# =====================================
# Monitoring Settings
# =====================================
BACKUP_DIRECTORY=/app/data/backups
WATCH_INTERVAL=5
MAX_FILE_SIZE=104857600

# =====================================
# Development Settings
# =====================================
# Set to 'false' in production
DEBUG=false
RELOAD=false
