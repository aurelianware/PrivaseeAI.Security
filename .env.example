# PrivaseeAI.Security Environment Configuration
# Copy this file to .env and update with your settings

# Application Settings
APP_NAME=PrivaseeAI.Security
APP_ENV=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Database Configuration (PostgreSQL with TimescaleDB)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=privaseeai_security
DATABASE_USER=privaseeai
DATABASE_PASSWORD=changeme
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# iOS Backup Configuration
IOS_BACKUP_PATH=/var/lib/privaseeai/backups
IOS_MONITOR_INTERVAL=60  # seconds
IOS_BACKUP_RETENTION_DAYS=90

# Security Settings
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Monitoring Settings
MONITORING_ENABLED=true
FILE_WATCH_DEBOUNCE_SECONDS=5
THREAT_SCAN_INTERVAL=300  # seconds

# Logging Configuration
LOG_FORMAT=json  # json or text
LOG_FILE_PATH=/var/log/privaseeai/security.log
LOG_ROTATION_SIZE=10485760  # 10 MB
LOG_BACKUP_COUNT=10

# STIX/TAXII Configuration
STIX_ENABLED=false
TAXII_SERVER_URL=
TAXII_API_ROOT=
TAXII_COLLECTION_ID=
TAXII_USERNAME=
TAXII_PASSWORD=

# Alert Configuration
ALERT_WEBHOOK_URL=
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Performance Settings
MAX_WORKERS=4
TASK_QUEUE_SIZE=1000
CACHE_TTL=3600  # seconds
